# Secrets — NIEMALS committen
.env
.env.api
*.pem
.admin-credentials

# Storefront (separater Clone von github.com/saleor/storefront)
storefront/

# Backups
storefront-backup/
*.sql.gz
*.sql

# Storefront-Custom Build-Artefakte (Source wird committet, Builds nicht)
storefront-custom/node_modules/
storefront-custom/.next/
storefront-custom/.env

# Root-level Build-Artefakte und Sandbox-Verzeichnis
