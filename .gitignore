/.next/
/src/

# Docker Volumes (lokal)
saleor-db/
saleor-redis/
saleor-media/

# OS
.DS_Store

# Postfix Runtime-State (DKIM Keys + DNS-TXT Outputs)
postfix-data/

# Temporäre / abgeleitete Service-Vorlagen — die echte saleor-storefront.service ist committed
*.service.new
