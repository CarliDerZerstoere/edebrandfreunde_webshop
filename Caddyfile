# Redirect www and apex to shop
www.edelbrandfreunde.at {
	redir https://shop.edelbrandfreunde.at{uri} permanent
}

shop.edelbrandfreunde.at {
	# Redirect alte URLs (z.B. von Wix/Squarespace) auf Saleor-Format
	@old-product path_regexp product /product-page/(.+)
	redir @old-product /oe/products/{re.product.1} permanent

	reverse_proxy host.docker.internal:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://api.edelbrandfreunde.at data: blob:; font-src 'self' data:; connect-src 'self' https://api.edelbrandfreunde.at; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		-X-XSS-Protection
	}
	encode gzip
}

api.edelbrandfreunde.at {
	# HINWEIS: Rate Limiting erfordert ein custom Caddy-Build mit dem rate_limit Plugin,
	# oder eine externe Lösung wie CrowdSec/fail2ban.
	# Die Auth-Routes im Storefront haben Application-Level Rate Limiting.

	# Hochgeladene Mediendateien direkt als statische Dateien ausliefern.
	# Django/Gunicorn liefert /media/ in Produktion (DEBUG=False) nicht aus.
	handle /media/* {
		uri strip_prefix /media
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	reverse_proxy api:8000 {
		header_up X-Forwarded-Proto https
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
		-X-XSS-Protection
	}
	encode gzip
}

admin.edelbrandfreunde.at {
	# ⚠️  WICHTIG: Basic Auth aktivieren für zusätzlichen Schutz!
	# Ohne Basic Auth ist das Dashboard nur durch Saleors eigene Authentifizierung geschützt.
	#
	# So aktivieren:
	#   1. Hash generieren: docker exec -it saleor-production-caddy-1 caddy hash-password
	#   2. Unten einsetzen und Kommentarzeichen entfernen
	#   3. docker compose restart caddy
	#
	# basicauth {
	#     admin $2a$14$REPLACE_WITH_BCRYPT_HASH
	# }
	reverse_proxy dashboard:80
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-XSS-Protection
	}
	encode gzip
}
