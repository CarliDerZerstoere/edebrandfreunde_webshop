# ============================================
# Saleor API Konfiguration
# ============================================
# Kopiere diese Datei: cp .env.api.example .env.api
# Ersetze alle CHANGE_ME und YOURDOMAIN.com Werte
# ============================================

# Datenbank (Passwort muss mit POSTGRES_PASSWORD in .env übereinstimmen)
DATABASE_URL=postgres://saleor:CHANGE_ME_POSTGRES_PASSWORD@db:5432/saleor

# Redis (Passwort muss mit REDIS_PASSWORD in .env übereinstimmen)
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1

# Django Secret Key (generieren: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Domain-Konfiguration — YOURDOMAIN.com durch deine Domain ersetzen
ALLOWED_HOSTS=api.YOURDOMAIN.com,localhost,api
ALLOWED_CLIENT_HOSTS=shop.YOURDOMAIN.com,admin.YOURDOMAIN.com
CORS_ALLOWED_ORIGINS=https://shop.YOURDOMAIN.com,https://admin.YOURDOMAIN.com
CSRF_TRUSTED_ORIGINS=https://api.YOURDOMAIN.com,https://admin.YOURDOMAIN.com

# Land & Währung
DEFAULT_COUNTRY=AT
DEFAULT_CURRENCY=EUR

# URLs
PUBLIC_URL=https://api.YOURDOMAIN.com
DASHBOARD_URL=https://admin.YOURDOMAIN.com
STOREFRONT_URL=https://shop.YOURDOMAIN.com

# SSL — wird von Caddy erledigt, Django darf NICHT redirecten
DEBUG=False
ENABLE_SSL=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
